<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-parent -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
  </parent>

  <groupId>dev.lukasgrigis.blog.amqp</groupId>
  <artifactId>spring-oauth2-amqp</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Spring OAuth2 AMQP</name>
  <description>OAuth2-secured messaging with Spring AMQP, RabbitMQ, and Keycloak</description>
  <url>https://github.com/lukas-grigis/spring-oauth2-amqp</url>
  <inceptionYear>2026</inceptionYear>

  <modules>
    <module>dispatcher</module>
    <module>worker</module>
    <module>reporter</module>
  </modules>

  <properties>
    <!-- General Project Settings -->
    <java.version>25</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Inherited by all modules. -->
  <dependencies>
    <!-- Back Spring's RestClient with Apache HttpClient 5. The OAuth2 client_credentials token POST then
         talks HTTP/1.1 over cleartext to Keycloak behind Traefik. Boot's default JDK HttpClient defaults to
         HTTP/2 and deadlocks on the cleartext h2c upgrade through Traefik; Apache HttpClient 5 negotiates
         HTTP/1.1 there, so the token client needs no protocol workaround. Version managed by Spring Boot. -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
          <configuration>
            <delimiters>
              <delimiter>@</delimiter>
            </delimiters>
            <useDefaultDelimiters>false</useDefaultDelimiters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
